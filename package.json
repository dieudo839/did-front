{
  "name": "did-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"*.{json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"*.{json,html}\"",
